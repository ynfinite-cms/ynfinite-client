<script type="application/ld+json">
    {
    "@context": "https://schema.org/", 
    "@type": "Product"
    {% if _yn_schema.name %}
        ,"name": {{_yn_schema.name|striptags|json_encode|raw}}
    {% endif %}
    {% if _yn_schema.image %}
        ,"image": "{{_yn_schema.image[0].path|raw}}"
    {% endif %}
    {% if _yn_schema.description %}
        ,"description": {{_yn_schema.description|striptags|json_encode|raw}}
    {% endif %}
    {% if _yn_schema.brandName %}
        ,"brand": {
            "@type": "Brand",
            "name": {{_yn_schema.brandName|striptags|json_encode|raw}}
        }
    {% endif %}
    {% if _yn_schema.offerType or _yn_schema.url or _yn_schema.currency or (_yn_schema.lowPrice is defined and _yn_schema.lowPrice is not same as(null)) or (_yn_schema.highPrice is defined and _yn_schema.highPrice is not same as(null)) or (_yn_schema.numberOfOffers is defined and _yn_schema.numberOfOffers is not same as(null)) or (_yn_schema.price is defined and _yn_schema.price is not same as(null)) or _yn_schema.priceValidUntil or _yn_schema.availability or _yn_schema.itemCondition %}
        ,"offers": {
            {% if _yn_schema.offerType %}
                "@type": "{{_yn_schema.offerType|raw}}"
            {% endif %}
            {% if _yn_schema.url %}
                ,"url": "{{_yn_schema.url|raw}}"
            {% endif %}
            {% if _yn_schema.currency %}
                ,"priceCurrency": "{{_yn_schema.currency|raw}}"
            {% endif %}
            {% if _yn_schema.lowPrice is defined and _yn_schema.lowPrice is not same as(null) %}
                ,"lowPrice": {{_yn_schema.lowPrice|striptags|json_encode|raw}}
            {% endif %}
            {% if _yn_schema.highPrice is defined and _yn_schema.highPrice is not same as(null) %}
                ,"highPrice": {{_yn_schema.highPrice|striptags|json_encode|raw}}
            {% endif %}
            {% if _yn_schema.numberOfOffers is defined and _yn_schema.numberOfOffers is not same as(null) %}
                ,"offerCount": {{_yn_schema.numberOfOffers|striptags|json_encode|raw}}
            {% endif %}
            {% if _yn_schema.price is defined and _yn_schema.price is not same as(null) %}
                ,"price": {{_yn_schema.price|striptags|json_encode|raw}}
            {% endif %}
            {% if _yn_schema.priceValidUntil %}
                ,"priceValidUntil": "{{_yn_schema.priceValidUntil|date('Y-m-d')}}"
            {% endif %}
            {% if _yn_schema.availability %}
                ,"availability": "https://schema.org/{{_yn_schema.availability|raw}}"
            {% endif %}
            {% if _yn_schema.itemCondition %}
                ,"itemCondition": "https://schema.org/{{_yn_schema.itemCondition|raw}}"
            {% endif %}
        }
    {% endif %}
    {% if _yn_schema.review %}
			,"review": [
				{% for _yn_review in _yn_schema.review %}
					{
						"@type": "Review",
						"name": {{_yn_review.name|striptags|json_encode|raw}},
						"reviewRating": {
							"@type": "Rating",
							"ratingValue": {{_yn_review.rating|striptags|json_encode|raw}}
						}
						{% if _yn_review.author %}
							,"author": {
								"@type": "Person",
								"name": {{_yn_review.author|striptags|json_encode|raw}}
							}
						{% endif %}
						{% if _yn_review.publisher %}
							,"publisher": {
								"@type": "Person",
								"name": {{_yn_review.publisher|striptags|json_encode|raw}}
							}
						{% endif %}
						{% if _yn_review.text %}
							,"reviewBody": {{_yn_review.text|striptags|json_encode|raw}}
						{% endif %}
					}{% if not loop.last %},{% endif %}
				{% endfor %}
			]
		{% endif %}
        {% if (_yn_schema.aggregateRatingValue is defined and _yn_schema.aggregateRatingValue is not same as(null)) or (_yn_schema.numberOfRatings is defined and _yn_schema.numberOfRatings is not same as(null)) or (_yn_schema.highestValueAllowed is defined and _yn_schema.highestValueAllowed is not same as(null)) or (_yn_schema.lowestValueAllowed is defined and _yn_schema.lowestValueAllowed is not same as(null)) %}
			,"aggregateRating": {
				"@type": "AggregateRating"
                {% if _yn_schema.aggregateRatingValue is defined and _yn_schema.aggregateRatingValue is not same as(null) %}
					,"ratingValue": {{_yn_schema.aggregateRatingValue|striptags|json_encode|raw}}
				{% endif %}
                {% if _yn_schema.numberOfRatings is defined and _yn_schema.numberOfRatings is not same as(null) %}
					,"reviewCount": {{_yn_schema.numberOfRatings|striptags|json_encode|raw}}
				{% endif %}
                {% if _yn_schema.highestValueAllowed is defined and _yn_schema.highestValueAllowed is not same as(null) %}
					,"bestRating": {{_yn_schema.highestValueAllowed|striptags|json_encode|raw}}
				{% endif %}
                {% if _yn_schema.lowestValueAllowed is defined and _yn_schema.lowestValueAllowed is not same as(null) %}
					,"worstRating": {{_yn_schema.lowestValueAllowed|striptags|json_encode|raw}}
				{% endif %}
			}
		{% endif %}
        {% if _yn_schema.awards %}
            ,"awards": [
                {% for _yn_awards in _yn_schema.awards %}
                    {{_yn_awards.award|striptags|json_encode|raw}}{% if not loop.last %},{% endif %}
                {% endfor %}
            ]
        {% endif %}
    }
</script>
