<script type="application/ld+json">
	{
	  	"@context": "https://schema.org"
	  	{% if _yn_schema.variant %}
			,"@type": "{{_yn_schema.variant|raw}}"
	  	{% endif %}
	  	{% if _yn_schema.name %}
    		,"name": {{_yn_schema.name|striptags|json_encode|raw}}
	  	{% endif %}
	  	{% if _yn_schema.image %}
    		,"image": "{{_yn_schema.image[0].path|raw}}"
	  	{% endif %}
	  	{% if _yn_schema.url %}
    		,"url": {{_yn_schema.url|striptags|json_encode|raw}}
	  	{% endif %}
	  	{% if _yn_schema.phone %}
    		,"telephone": {{_yn_schema.phone|striptags|json_encode|raw}}
	  	{% endif %}
		{% if _yn_schema.street or _yn_schema.city or _yn_schema.zip or _yn_schema.country %}
			,"address": {
				"@type": "PostalAddress"
				{% if _yn_schema.street %}
					,"streetAddress": {{_yn_schema.street|striptags|json_encode|raw}}
				{% endif %}
				{% if _yn_schema.city %}
					,"addressLocality": {{_yn_schema.city|striptags|json_encode|raw}}
				{% endif %}
				{% if _yn_schema.zip %}
					,"postalCode": {{_yn_schema.zip|striptags|json_encode|raw}}
				{% endif %}
				{% if _yn_schema.country %}
					,"addressCountry": {{_yn_schema.country|striptags|json_encode|raw}}
				{% endif %}
			}
		{% endif %}
		{% if _yn_schema.latitude or _yn_schema.longitude %}
			,"geo": {
				"@type": "GeoCoordinates"
				{% if _yn_schema.latitude %}
					,"latitude": "{{_yn_schema.latitude|raw}}"
				{% endif %}
				{% if _yn_schema.longitude %}
					,"longitude": "{{_yn_schema.longitude|raw}}"
				{% endif %}
			}
		{% endif %}
		{% if _yn_schema.openingHours %}
			,"openingHoursSpecification": [
				{% for _yn_openingHour in _yn_schema.openingHours %}
					{
						"@type": "OpeningHoursSpecification",
						"dayOfWeek": [{% for _yn_day in _yn_openingHour.days %}"{{_yn_day|raw}}"{% if not loop.last %},{% endif %}{% endfor %}],
						"opens": "{{_yn_openingHour.opens|date('H:i')}}",
						"closes": "{{_yn_openingHour.closes|date('H:i')}}"
					}{% if not loop.last %},{% endif %}
				{% endfor %}
			]
		{% endif %}
		{% if _yn_schema.sameAs %}
			,"sameAs": [{% for _yn_sameAs in _yn_schema.sameAs %}"{{_yn_sameAs.url|raw}}"{% if not loop.last %},{% endif %}{% endfor %}]
		{% endif %}
		{% if _yn_schema.review %}
			,"review": [
				{% for _yn_review in _yn_schema.review %}
					{
						"@type": "Review",
						"name": {{_yn_review.name|striptags|json_encode|raw}},
						"reviewRating": {
							"@type": "Rating",
							"ratingValue": {{_yn_review.rating|striptags|json_encode|raw}}
						}
						{% if _yn_review.author %}
							,"author": {
								"@type": "Person",
								"name": {{_yn_review.author|striptags|json_encode|raw}}
							}
						{% endif %}
						{% if _yn_review.publisher %}
							,"publisher": {
								"@type": "Person",
								"name": {{_yn_review.publisher|striptags|json_encode|raw}}
							}
						{% endif %}
						{% if _yn_review.text %}
							,"reviewBody": {{_yn_review.text|striptags|json_encode|raw}}
						{% endif %}
					}{% if not loop.last %},{% endif %}
				{% endfor %}
			]
		{% endif %}
		{% if _yn_schema.aggregateRatingValue or _yn_schema.numberOfRatings or _yn_schema.highestValueAllowed or _yn_schema.lowestValueAllowed %}
			,"aggregateRating": {
				"@type": "AggregateRating"
				{% if _yn_schema.aggregateRatingValue %}
					,"ratingValue": {{_yn_schema.aggregateRatingValue|striptags|json_encode|raw}}
				{% endif %}
				{% if _yn_schema.numberOfRatings %}
					,"reviewCount": {{_yn_schema.numberOfRatings|striptags|json_encode|raw}}
				{% endif %}
				{% if _yn_schema.highestValueAllowed %}
					,"bestRating": {{_yn_schema.highestValueAllowed|striptags|json_encode|raw}}
				{% endif %}
				{% if _yn_schema.lowestValueAllowed %}
					,"worstRating": {{_yn_schema.lowestValueAllowed|striptags|json_encode|raw}}
				{% endif %}
			}
		{% endif %}
	}
</script>