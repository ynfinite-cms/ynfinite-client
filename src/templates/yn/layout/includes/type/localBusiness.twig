<script type="application/ld+json">
	{
	  	"@context": "https://schema.org"
	  	{% if _yn_schema.variant is defined and _yn_schema.variant is not same as(null) %}
			,"@type": "{{_yn_schema.variant|raw}}"
	  	{% endif %}
	  	{% if _yn_schema.name is defined and _yn_schema.name is not same as(null) %}
    		,"name": "{{_yn_schema.name|raw}}"
	  	{% endif %}
	  	{% if _yn_schema.image is defined and _yn_schema.image is not same as(null) %}
    		,"image": "{{_yn_schema.image[0].path|raw}}"
	  	{% endif %}
	  	{% if _yn_schema.url is defined and _yn_schema.url is not same as(null) %}
    		,"url": "{{_yn_schema.url|raw}}"
	  	{% endif %}
	  	{% if _yn_schema.phone is defined and _yn_schema.phone is not same as(null) %}
    		,"telephone": "{{_yn_schema.phone|raw}}"
	  	{% endif %}
		{% if (_yn_schema.street is defined and _yn_schema.street is not same as(null)) or (_yn_schema.city is defined and _yn_schema.city is not same as(null)) or (_yn_schema.zip is defined and _yn_schema.zip is not same as(null)) or (_yn_schema.country is defined and _yn_schema.country is not same as(null)) %}
			,"address": {
				"@type": "PostalAddress"
				{% if _yn_schema.street is defined and _yn_schema.street is not same as(null) %}
					,"streetAddress": "{{_yn_schema.street|raw}}"
				{% endif %}
				{% if _yn_schema.city is defined and _yn_schema.city is not same as(null) %}
					,"addressLocality": "{{_yn_schema.city|raw}}"
				{% endif %}
				{% if _yn_schema.zip is defined and _yn_schema.zip is not same as(null) %}
					,"postalCode": "{{_yn_schema.zip|raw}}"
				{% endif %}
				{% if _yn_schema.country is defined and _yn_schema.country is not same as(null) %}
					,"addressCountry": "{{_yn_schema.country|raw}}"
				{% endif %}
			}
		{% endif %}
		{% if (_yn_schema.latitude is defined and _yn_schema.latitude is not same as(null)) or (_yn_schema.longitude is defined and _yn_schema.longitude is not same as(null)) %}
			,"geo": {
				"@type": "GeoCoordinates"
				{% if _yn_schema.latitude is defined and _yn_schema.latitude is not same as(null) %}
					,"latitude": "{{_yn_schema.latitude|raw}}"
				{% endif %}
				{% if _yn_schema.longitude is defined and _yn_schema.longitude is not same as(null) %}
					,"longitude": "{{_yn_schema.longitude|raw}}"
				{% endif %}
			}
		{% endif %}
		{% if _yn_schema.openingHours %}
			,"openingHoursSpecification": [
				{% for _yn_openingHour in _yn_schema.openingHours %}
					{
						"@type": "OpeningHoursSpecification",
						"dayOfWeek": [{% for _yn_day in _yn_openingHour.days %}"{{_yn_day|raw}}"{% if not loop.last %},{% endif %}{% endfor %}],
						"opens": "{{_yn_openingHour.opens|date('H:i')}}",
						"closes": "{{_yn_openingHour.closes|date('H:i')}}"
					}{% if not loop.last %},{% endif %}
				{% endfor %}
			]
		{% endif %}
		{% if _yn_schema.sameAs %}
			,"sameAs": [{% for _yn_sameAs in _yn_schema.sameAs %}"{{_yn_sameAs.url|raw}}"{% if not loop.last %},{% endif %}{% endfor %}]
		{% endif %}
		{% if _yn_schema.review %}
			,"review": [
				{% for _yn_review in _yn_schema.review %}
					{
						"@type": "Review",
						"name": "{{_yn_review.name|raw}}",
						"reviewRating": {
							"@type": "Rating",
							"ratingValue": "{{_yn_review.rating|raw}}"
						}
						{% if _yn_review.author %}
							,"author": {
								"@type": "Person",
								"name": "{{_yn_review.author|raw}}"
							}
						{% endif %}
						{% if _yn_review.publisher %}
							,"publisher": {
								"@type": "Person",
								"name": "{{_yn_review.publisher|raw}}"
							}
						{% endif %}
						{% if _yn_review.text %}
							,"reviewBody": "{{_yn_review.text|raw}}"
						{% endif %}
					}{% if not loop.last %},{% endif %}
				{% endfor %}
			]
		{% endif %}
		{% if (_yn_schema.aggregateRatingValue is defined and _yn_schema.aggregateRatingValue is not same as(null)) or (_yn_schema.numberOfRatings is defined and _yn_schema.numberOfRatings is not same as(null)) or (_yn_schema.highestValueAllowed is defined and _yn_schema.highestValueAllowed is not same as(null)) or (_yn_schema.lowestValueAllowed is defined and _yn_schema.lowestValueAllowed is not same as(null)) %}
			,"aggregateRating": {
				"@type": "AggregateRating"
				{% if _yn_schema.aggregateRatingValue is defined and _yn_schema.aggregateRatingValue is not same as(null) %}
					,"ratingValue": "{{_yn_schema.aggregateRatingValue|raw}}"
				{% endif %}
				{% if _yn_schema.numberOfRatings is defined and _yn_schema.numberOfRatings is not same as(null) %}
					,"reviewCount": "{{_yn_schema.numberOfRatings|raw}}"
				{% endif %}
				{% if _yn_schema.highestValueAllowed is defined and _yn_schema.highestValueAllowed is not same as(null) %}
					,"bestRating": "{{_yn_schema.highestValueAllowed|raw}}"
				{% endif %}
				{% if _yn_schema.lowestValueAllowed is defined and _yn_schema.lowestValueAllowed is not same as(null) %}
					,"worstRating": "{{_yn_schema.lowestValueAllowed|raw}}"
				{% endif %}
			}
		{% endif %}
	}
</script>
